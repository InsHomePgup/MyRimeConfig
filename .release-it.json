{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "commitMessage": "chore: 发布 v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "v${version}",
    "push": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "header": "# 更新日志",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          { "type": "feat", "section": "新功能" },
          { "type": "fix", "section": "修复" },
          { "type": "perf", "section": "性能" },
          { "type": "revert", "section": "回退" },
          { "type": "docs", "section": "文档" }
        ]
      }
    }
  }
}
